# GEMINI_API_KEY: Optional, only required if Gemini AI routes are added.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this app is hosted (e.g. https://your-app.vercel.app).
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT_JSON: REQUIRED in Vercel for persistent Cloud Firestore server storage.
# Paste the single-line JSON (or base64-encoded JSON) from Firebase Console -> Project Settings -> Service Accounts.
# Alternatively, set FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, and FIREBASE_PRIVATE_KEY separately.
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIRESTORE_DATABASE_ID=""
